    /**
     * Traduce la ruta guardada en la base a una URL que el navegador
     * pueda pedir, sin depender de ningun mapeo del web.xml.
     *
     *   "img/propiedades/x.jpg"   -> se deja igual (recurso estatico)
     *   "media/propiedades/x.jpg" -> controladores/media-propiedad.jsp?archivo=x.jpg
     */
    public static String urlDeImagen(String ruta) {

        if (ruta == null || ruta.isBlank()) {
            return null;
        }

        String prefijo = "media/propiedades/";

        if (ruta.startsWith(prefijo)) {
            return "controladores/media-propiedad.jsp?archivo="
                 + ruta.substring(prefijo.length());
        }

        return ruta;
    }

    public static class ImagenPropiedad {
        private int id;
        private int propiedadId;
        private String ruta;
        private String textoAlt;
        private boolean esPortada;
        private int orden;

        public int getId() { return id; }
        public void setId(int id) { this.id = id; }
        public int getPropiedadId() { return propiedadId; }
        public void setPropiedadId(int propiedadId) { this.propiedadId = propiedadId; }
        public String getRuta() { return ruta; }
        public void setRuta(String ruta) { this.ruta = ruta; }

        /**
         * URL con la que la vista pinta esta imagen.
         *
         * En la tabla la ruta se guarda de dos formas:
         *   "img/propiedades/x.jpg"    -> archivo estatico del sitio
         *   "media/propiedades/x.jpg"  -> archivo subido por un agente,
         *                                 guardado fuera del webapp
         *
         * El segundo caso lo entrega controladores/media-propiedad.jsp.
         * Antes esa pagina estaba mapeada en /media/propiedades/* desde el
         * web.xml; al quitar ese mapeo la URL se arma aqui, sin tener que
         * modificar lo que ya esta guardado en la base.
         */
        public String getUrl() { return urlDeImagen(ruta); }
        public String getTextoAlt() { return textoAlt; }
        public void setTextoAlt(String textoAlt) { this.textoAlt = textoAlt; }
        public boolean isEsPortada() { return esPortada; }
        public void setEsPortada(boolean esPortada) { this.esPortada = esPortada; }
        public int getOrden() { return orden; }
        public void setOrden(int orden) { this.orden = orden; }
    }

