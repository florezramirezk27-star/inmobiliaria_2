<%-- entidades.jspf
     Modelos del dominio como CLASES ANIDADAS ESTÁTICAS del servlet.
     Cada JSP que incluya este fragmento compila sus propias copias privadas;
     los objetos viajan entre JSP como atributos y se leen con EL (reflexión),
     por lo que la identidad de la clase no importa fuera de la página.
     Se declaran en <%! %> (no como clases locales) para que el compilador
     de Jasper, que usa source 1.7, permita métodos y campos estáticos.

     Los enums originales se representan como clases con constantes estáticas
     del mismo tipo para conservar las comparaciones con == y los callbacks
     name() / valueOf() que el código original usaba. --%>
<%!
    // ============================================================
    // Enums (como clases anidadas estáticas con constantes estáticas)
    // ============================================================

    public static class Operacion {
        public static final Operacion ARRIENDO = new Operacion("ARRIENDO", "Arriendo", true);
        public static final Operacion VENTA = new Operacion("VENTA", "Venta", false);

        private final String nombre;
        private final String etiqueta;
        private final boolean periodica;

        private Operacion(String nombre, String etiqueta, boolean periodica) {
            this.nombre = nombre;
            this.etiqueta = etiqueta;
            this.periodica = periodica;
        }

        public String getEtiqueta() { return etiqueta; }
        public boolean isPeriodica() { return periodica; }
        public String name() { return nombre; }
        public String getNombre() { return nombre; }

        @Override
        public String toString() { return nombre; }

        public static Operacion desde(String valor) {
            if (valor == null || valor.isBlank()) {
                return null;
            }
            String v = valor.trim().toUpperCase();
            if ("ARRIENDO".equals(v)) return ARRIENDO;
            if ("VENTA".equals(v)) return VENTA;
            return null;
        }
    }

    public static class EstadoPropiedad {
        public static final EstadoPropiedad BORRADOR = new EstadoPropiedad("BORRADOR", "Borrador");
        public static final EstadoPropiedad PUBLICADA = new EstadoPropiedad("PUBLICADA", "Publicada");
        public static final EstadoPropiedad RESERVADA = new EstadoPropiedad("RESERVADA", "Reservada");
        public static final EstadoPropiedad CERRADA = new EstadoPropiedad("CERRADA", "Cerrada");

        private final String nombre;
        private final String etiqueta;

        private EstadoPropiedad(String nombre, String etiqueta) {
            this.nombre = nombre;
            this.etiqueta = etiqueta;
        }

        public String getEtiqueta() { return etiqueta; }
        public String name() { return nombre; }
        public String getNombre() { return nombre; }

        @Override
        public String toString() { return nombre; }

        public static EstadoPropiedad desde(String valor) {
            if (valor == null || valor.isBlank()) {
                return null;
            }
            String v = valor.trim().toUpperCase();
            if ("BORRADOR".equals(v)) return BORRADOR;
            if ("PUBLICADA".equals(v)) return PUBLICADA;
            if ("RESERVADA".equals(v)) return RESERVADA;
            if ("CERRADA".equals(v)) return CERRADA;
            return null;
        }
    }

