    public static class EstadoCita {
        public static final EstadoCita SOLICITADA = new EstadoCita("SOLICITADA", "Solicitada");
        public static final EstadoCita CONFIRMADA = new EstadoCita("CONFIRMADA", "Confirmada");
        public static final EstadoCita RECHAZADA = new EstadoCita("RECHAZADA", "Rechazada");
        public static final EstadoCita REALIZADA = new EstadoCita("REALIZADA", "Realizada");
        public static final EstadoCita CANCELADA = new EstadoCita("CANCELADA", "Cancelada");

        private final String nombre;
        private final String etiqueta;

        private EstadoCita(String nombre, String etiqueta) {
            this.nombre = nombre;
            this.etiqueta = etiqueta;
        }

        public String getEtiqueta() { return etiqueta; }
        public String name() { return nombre; }
        public String getNombre() { return nombre; }

        @Override
        public String toString() { return nombre; }

        public static EstadoCita desde(String valor) {
            if (valor == null || valor.isBlank()) {
                return null;
            }
            String v = valor.trim().toUpperCase();
            if ("SOLICITADA".equals(v)) return SOLICITADA;
            if ("CONFIRMADA".equals(v)) return CONFIRMADA;
            if ("RECHAZADA".equals(v)) return RECHAZADA;
            if ("REALIZADA".equals(v)) return REALIZADA;
            if ("CANCELADA".equals(v)) return CANCELADA;
            return null;
        }
    }

    public static class EstadoDocumento {
        public static final EstadoDocumento PENDIENTE = new EstadoDocumento("PENDIENTE");
        public static final EstadoDocumento APROBADO = new EstadoDocumento("APROBADO");
        public static final EstadoDocumento RECHAZADO = new EstadoDocumento("RECHAZADO");

        private final String nombre;

        private EstadoDocumento(String nombre) {
            this.nombre = nombre;
        }

        public String name() { return nombre; }
        public String getNombre() { return nombre; }

        @Override
        public String toString() { return nombre; }

        public static EstadoDocumento desde(String valor) {
            if (valor == null || valor.isBlank()) {
                return null;
            }
            String v = valor.trim();
            if ("PENDIENTE".equalsIgnoreCase(v)) return PENDIENTE;
            if ("APROBADO".equalsIgnoreCase(v)) return APROBADO;
            if ("RECHAZADO".equalsIgnoreCase(v)) return RECHAZADO;
            return null;
        }
    }

